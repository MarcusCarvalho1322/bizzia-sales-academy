# =============================================================
# BIZZ.IA SALES ACADEMY — variaveis de ambiente
# Copie para .env.local em desenvolvimento.
# Em producao, cadastre em: Vercel > Settings > Environment Variables
# NUNCA versione o arquivo .env real. Nenhuma destas chaves
# pode aparecer em codigo de cliente.
# =============================================================

# Chave da Claude API — SOMENTE server-side.
# Usada exclusivamente em app/api/simulate/route.ts.
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado no modulo de simulacao (opcional).
# Padrao: claude-sonnet-4-20250514
ANTHROPIC_MODEL=

# String de conexao do banco Neon (PostgreSQL).
# Ainda nao provisionado — ver docs/schema-neon.sql e prisma/schema.prisma.
DATABASE_URL=

# NextAuth — segredo de assinatura de sessao.
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL publica da aplicacao.
# Producao: https://bizzia-sales-academy.vercel.app
NEXTAUTH_URL=

# Limite de chamadas a Claude API por usuario, por janela de 1 minuto.
# Padrao: 10
RATE_LIMIT_PER_MINUTE=
